{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parsian.local/governance/task.schema.json",
  "title": "Parsian multi-agent task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "owner",
    "workspace",
    "permissions",
    "scope",
    "dependencies",
    "contracts",
    "acceptance_criteria",
    "tests",
    "deliverables",
    "approvals"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "SPECIFIED",
        "READY",
        "ASSIGNED",
        "IN_PROGRESS",
        "IMPLEMENTATION_COMPLETE",
        "CODE_REVIEW",
        "QA",
        "SECURITY_REVIEW",
        "INTEGRATION_READY",
        "INTEGRATING",
        "INTEGRATED",
        "VERIFIED",
        "COMPLETE",
        "BLOCKED",
        "CANCELLED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "role"],
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "path", "base_commit"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "OBSERVE",
          "ANALYZE",
          "PROPOSE",
          "WRITE_SCOPED",
          "TEST_SCOPED",
          "INTEGRATE",
          "RELEASE_PREPARE"
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"}
    },
    "contracts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "security", "integration"],
      "properties": {
        "architecture": {"enum": ["required", "not-required", "approved"]},
        "security": {"enum": ["required", "not-required", "approved"]},
        "integration": {"enum": ["required", "not-required", "approved"]}
      }
    }
  }
}
