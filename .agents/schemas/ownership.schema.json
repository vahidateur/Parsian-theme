{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parsian.local/governance/ownership.schema.json",
  "title": "Parsian file ownership registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "entries"],
  "properties": {
    "version": {"const": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "task_id",
          "owner_agent",
          "mode",
          "workspace",
          "base_commit",
          "status",
          "lease_started_at",
          "lease_expires_at",
          "last_heartbeat_at",
          "dependencies",
          "integration_status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
          },
          "owner_agent": {"type": "string", "minLength": 1},
          "mode": {"enum": ["exclusive", "scoped"]},
          "workspace": {"type": "string", "minLength": 1},
          "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "status": {"enum": ["active", "released", "expired", "revoked"]},
          "lease_started_at": {"type": "string", "minLength": 1},
          "lease_expires_at": {"type": "string", "minLength": 1},
          "last_heartbeat_at": {"type": "string", "minLength": 1},
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"}
          },
          "integration_status": {
            "enum": ["pending", "integrated", "rejected", "not_applicable"]
          }
        }
      }
    }
  }
}
