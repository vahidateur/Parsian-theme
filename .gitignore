# Local runtime — never commit
wp-local/site/
wp-local/mysql/
wp-local/mysql-files/
wp-local/*.log
wp-local/*.sock
wp-local/wp-cli.phar
wp-local/backups/*.zip
*.sql
*.log
*.so

# Python / OS noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Node.js test dependencies
node_modules/
npm-debug.log*

# CI/package output
dist/
.ci-wordpress/

# Keep release zips out of history bloat (root zip is the installable artifact; keep it)
# Uncomment to exclude zips as well:
# *.zip
